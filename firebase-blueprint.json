{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "Messages sent from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender's name" },
        "email": { "type": "string", "format": "email", "description": "Sender's email" },
        "message": { "type": "string", "description": "The message content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A portfolio project.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string", "description": "Max 100 chars for the card" },
        "fullDescription": { "type": "string", "description": "Complete project description" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "Up to 5 image URLs" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "github": { "type": "string" },
        "live": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["title", "shortDescription", "fullDescription", "images", "tags"]
    },
    "Certification": {
      "title": "Certification",
      "description": "A professional certification.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "techLearned": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "integer" }
      },
      "required": ["name", "issuer", "date", "image"]
    },
    "Badge": {
      "title": "Badge",
      "description": "A professional badge from GitHub, LeetCode, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "explanation": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["name", "issuer", "explanation", "image", "link"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of contact messages."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects."
    },
    "/certifications/{certId}": {
      "schema": "Certification",
      "description": "Collection of certifications."
    },
    "/badges/{badgeId}": {
      "schema": "Badge",
      "description": "Collection of badges."
    }
  }
}
